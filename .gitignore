# ===== 备份残留（热修过程产生的 .bak-pNN 等） =====
*.bak*

# ===== Python 运行时 =====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ===== 测试 / 缓存 =====
.pytest_cache/
.coverage
htmlcov/

# ===== 运行时数据 / 密钥（永远不进仓库，真实配置在 data/.config.yaml） =====
# 锚定到仓根，避免误伤 models/.../silero_vad/data 等模型子目录
/data/
*.log
*.pid
*.db

# ===== 上游审计快照（不入仓：体积大且避免把上游源码纳入本仓分发；获取方式见 UPSTREAM_DECOUPLING.md §2） =====
/_reference_snapshot/

# ===== 密钥 / 环境变量 =====
.env
.env.*
*.config.yaml

# ===== 脱 MIT 审计证据（本地保留、不进公开仓：含法律脱钩策略，勿误提交） =====
/audit/

# ===== 编辑器 / OS =====
.idea/
.vscode/
.DS_Store
Thumbs.db
.workbuddy/
# macOS AppleDouble 资源叉文件（会在拷贝进构建机时混入镜像/py_compile 报错）
._*
__MACOSX/

# ===== 前端构建产物（若有） =====
node_modules/
dist/
